# Server only. Create a Pinata JWT with permission to upload public files.
PINATA_JWT=replace_with_pinata_jwt
PIMLICO_API_KEY=replace_with_pimlico_api_key

# Optional always-on Telegram and Push listener. Keep every secret server-side.
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
PUSH_CHANNEL_PRIVATE_KEY=replace_with_push_channel_signer_private_key

# Public browser configuration. Never put a private key in these variables.
NEXT_PUBLIC_NFT_ADDRESS=0x39d7712A2E18d4c0597E849Cb9dc6869F6996639
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://your-sepolia-rpc.example
NEXT_PUBLIC_MAINNET_RPC_URL=https://your-mainnet-rpc.example
NEXT_PUBLIC_PUSH_CHANNEL=eip155:11155111:0xYourPushChannelAddress
